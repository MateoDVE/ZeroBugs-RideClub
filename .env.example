# Frontend-safe values from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Only for Supabase Edge Functions / local CLI. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
BOOTSTRAP_SECRET=USE_A_LONG_RANDOM_SECRET
